PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
BLADE_OS_BASE_URL=http://115.190.152.1
BLADE_OS_PAT=
BLADE_OS_TIMEOUT_MS=30000
PENDING_INPUT_PATH=共享/pending.md
CONFIRMED_OUTPUT_PATH=共享/prototype.html
PENDING_POLL_INTERVAL_MS=3000
# SQLite 持久化路径（界面稿版本机制）。容器内建议挂载持久卷到 /var/lib/interface-agent
INTERFACE_AGENT_DB_PATH=/var/lib/interface-agent/interface-agent.db
# 会话 Cookie 签名密钥（HMAC-SHA256）。生产必须配置为高熵随机串；留空则启动时生成
# 临时密钥（重启后所有会话 Cookie 失效）。例：openssl rand -base64 32
INTERFACE_AGENT_SESSION_SECRET=
# 仅在 TLS（生产）下设为 1，为会话 Cookie 增加 Secure 标志
INTERFACE_AGENT_COOKIE_SECURE=0
# 一次性启动码有效期（毫秒），允许 60000-120000
INTERFACE_AGENT_START_CODE_TTL_MS=90000
# 异步生成 worker 轮询间隔（毫秒）
GENERATION_POLL_INTERVAL_MS=1500
# 服务间共享密钥（resolve CREATE 的 X-Internal-Token）。必须与 agent-pipeline
# 配置相同的值。留空 → fail-closed（拒绝所有会话创建）。例：openssl rand -base64 32
INTERFACE_AGENT_INTERNAL_TOKEN=
